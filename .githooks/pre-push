#!/bin/sh
# 交付门禁：push 前全量 check + test（交付=push 的机械保障）。
# test 走 vitest 默认池（forks）：#72 复审实证 forks/threads/vmThreads 三池
# 67 文件全绿（vitest 4.1.11 + happy-dom 20.14.5），旧「threads/forks 必挂」
# 系 happy-dom 18 时代残留已证伪，不再透传 vmThreads。
echo "[pre-push] workspace check..."
npm run check --workspaces --if-present || {
  echo "[pre-push] check 未过，push 中止。修复后再推（勿 --no-verify 绕过）。" >&2
  exit 1
}
echo "[pre-push] workspace test..."
npm run test --workspaces --if-present || {
  echo "[pre-push] test 未过，push 中止。修复后再推（勿 --no-verify 绕过）。" >&2
  exit 1
}
echo "[pre-push] 全绿，放行。"
