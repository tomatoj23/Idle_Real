{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillsContent",
  "description": "技能类内容：六艺修行的挂机技能定义（最小样例 schema，issue #2 扩全）",
  "type": "object",
  "required": ["skills"],
  "additionalProperties": false,
  "properties": {
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/skill" }
    }
  },
  "definitions": {
    "skill": {
      "type": "object",
      "required": ["id", "name", "baseInterval", "baseExp"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "稳定标识符：存档与引擎引用均用它"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "description": "显示名（中文）"
        },
        "description": {
          "type": "string",
          "maxLength": 120,
          "description": "一句话风味描述"
        },
        "baseInterval": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "基础行动间隔（毫秒）"
        },
        "baseExp": {
          "type": "number",
          "minimum": 0,
          "description": "单次行动基础修为"
        },
        "maxLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "description": "层数上限（1~99）"
        }
      }
    }
  }
}
