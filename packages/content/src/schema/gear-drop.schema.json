{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GearDropsSection",
  "description": "content 包 gearDrops 节：异宝（妖物专属装备）掉落表。pool 引用的物品存在性、equip 类型与敌人 id 存在性由语义校验补全。",
  "type": "array",
  "items": { "$ref": "#/definitions/gearDrop" },
  "definitions": {
    "gearDrop": {
      "type": "object",
      "required": ["enemy", "chance", "pool"],
      "additionalProperties": false,
      "properties": {
        "enemy": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "敌人 id"
        },
        "chance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "装备掉率"
        },
        "pool": {
          "type": "array",
          "minItems": 1,
          "description": "异宝池：equip 类物品 id 列表",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
        }
      }
    }
  }
}
