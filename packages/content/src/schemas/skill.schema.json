{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SkillsSection",
  "description": "content 包 skills 节：技艺定义。kind=gather 的技艺携带 activities（含副产出 byproduct）；craft 的动作是 recipes，combat 的动作是斗法。",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/definitions/skill" },
  "definitions": {
    "skill": {
      "type": "object",
      "required": ["id", "name", "icon", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "稳定标识符：存档与引擎引用均用它"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12,
          "description": "显示名（中文）"
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2,
          "description": "单字图标（汉字）"
        },
        "kind": {
          "enum": ["gather", "craft", "combat"],
          "description": "gather 采集 / craft 炼制 / combat 斗法"
        },
        "description": {
          "type": "string",
          "maxLength": 120,
          "description": "一句话风味描述"
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "description": "采集活动列表，按解锁层升序",
          "items": { "$ref": "#/definitions/activity" }
        }
      }
    },
    "activity": {
      "type": "object",
      "required": ["name", "unlockLevel", "interval", "exp", "output"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "unlockLevel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99,
          "description": "解锁所需技艺层数"
        },
        "interval": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "单次行动耗时（毫秒）"
        },
        "exp": {
          "type": "number",
          "minimum": 0,
          "description": "单次行动修为"
        },
        "output": { "$ref": "#/definitions/stack" },
        "byproduct": {
          "type": "object",
          "required": ["item", "chance"],
          "additionalProperties": false,
          "description": "副产出：以 chance 概率额外获得（如采药得灵蚕丝）",
          "properties": {
            "item": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
            "chance": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "stack": {
      "type": "object",
      "required": ["item", "count"],
      "additionalProperties": false,
      "properties": {
        "item": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "count": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
