{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EnemiesSection",
  "description": "content 包 enemies 节：敌人数值、常规掉落与受击方式。每个敌人 id 须在 combatText.moves 注册招式名。element/affinities 为可选系别字段（只给 Boss/特色怪配，不填=凡击无系别，零破坏）。",
  "type": "array",
  "minItems": 1,
  "items": { "$ref": "#/definitions/enemy" },
  "definitions": {
    "enemy": {
      "type": "object",
      "required": ["id", "name", "icon", "level", "kind", "hp", "atk", "def", "attackInterval", "exp", "gold", "drops"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "prototypeKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "ADR-015 原型继承：声明本条目可被同集合条目继承；值必须等于自身 id（语义校验）"
        },
        "prototypeParent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "ADR-015 原型继承：继承同集合内已声明 prototypeKey 的父条目；父不存在或未声明即大声失败（语义校验）"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 12
        },
        "icon": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "description": "层数；上限单一来源 = config.progression.maxLevel（语义校验对照，schema 魔法数 99 已清退，#021 批 4）"
        },
        "kind": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9_]*$",
          "description": "动词池键（#021 批 4 开放键域，ADR-016 裁决 ⑦）：须在 combatText.verbs 注册（语义校验）；claw/magic 仅为官方包内容约定，新增风格 = 新 JSON 键"
        },
        "element": {
          "enum": ["metal", "wood", "water", "fire", "earth", "wind", "thunder"],
          "description": "系别（金木水火土风雷，ADR-012）；不填=凡击无系别。只给 Boss/特色怪配"
        },
        "affinities": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "description": "系别亲和：受该系攻击的伤害调整百分点（负=抗性，正=易伤），只给 Boss/特色怪配",
          "patternProperties": {
            "^(metal|wood|water|fire|earth|wind|thunder)$": {
              "type": "integer",
              "minimum": -100,
              "maximum": 100
            }
          }
        },
        "hp": { "type": "number", "minimum": 1 },
        "atk": { "type": "number", "minimum": 1 },
        "def": { "type": "number", "minimum": 0 },
        "attackInterval": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "攻击间隔（毫秒）"
        },
        "exp": {
          "type": "number",
          "minimum": 0,
          "description": "击杀修为"
        },
        "gold": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "description": "击杀掉落灵石区间",
          "properties": {
            "min": { "type": "integer", "minimum": 0 },
            "max": { "type": "integer", "minimum": 0 }
          }
        },
        "drops": {
          "type": "array",
          "description": "常规物品掉落表",
          "items": { "$ref": "#/definitions/drop" }
        }
      }
    },
    "drop": {
      "type": "object",
      "required": ["item", "chance"],
      "additionalProperties": false,
      "properties": {
        "item": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "chance": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
